@using System.Text.RegularExpressions
@model MyMvcApp.Models.ViewModels.SheduleViewModel
        <section class="section">
            <div class="mainDiv">
                <form asp-action="Create" method="post">
                    <div class="divselect">
                        <label for="vanue">Місце проведення:</label>
                        <select class="form-select" aria-label="Default select example">
                            @foreach (var schedule in Model.Places)
                            {
                                <option value=@schedule.PlaceId>@schedule.DestinationName</option>
                            }
                        </select>
                    </div>
                    <div class="divselect">
                        <label for="vanue">День проведення:</label>
                        <select class="form-select" aria-label="Default select example">
                            @foreach (var day in Model.DayOfWeek)
                            {
                                <option value=@day">@day</option>
                            }
                        </select>
                    </div>
                    <input type="time" asp-for="Time">
                    <input type="submit" value="Створити" class="button" />
                </form>
            </div>
            <section>
                <div class="schedule-container">
                    <h2>Розклад Занять Групи [G03]</h2>
                    <table class="table table-dark">
                        <thead>
                            <tr>
                                <th>День Тижня</th>
                                <th>Початок Дня</th>
                                <th>Кінець Дня</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th>Понеділок</th>
                                <td>-</td>
                                <td>-</td>
                            </tr>
                            <tr>
                                <th>Вівторок</th>
                                <td>-</td>
                                <td>-</td>
                            </tr>
                            <tr>
                                <th>Середа</th>
                                <td>-</td>
                                <td>-</td>
                            </tr>
                            <tr>
                                <th>Четвер</th>
                                <td>-</td>
                                <td>-</td>
                            </tr>
                            <tr>
                                <th>П'ятниця</th>
                                <td>-</td>
                                <td>-</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </section>