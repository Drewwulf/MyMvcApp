@using System.Text.RegularExpressions
@model MyMvcApp.Models.ViewModels.SheduleViewModel
        <section class="section">
            <div class="mainDiv">
                <form asp-action="Create" method="post">
                    <div class="divselect">
                        <label for="vanue">Місце проведення:</label>
                        <select class="form-select" aria-label="Default select example" asp-for="PlaceId">
                            @foreach (var schedule in Model.Places)
                            {
                                <option value=@schedule.PlaceId>@schedule.DestinationName</option>
                            }
                        </select>
                    </div>
                    <div class="divselect">
                        <label for="vanue">День проведення:</label>
                <select class="form-select" aria-label="Default select example" asp-for="DayOfWeek">
                            @foreach (var day in Model.DaysOfWeek)
                            {
                                <option value=@day>@day</option>
                            }
                        </select>
                    </div>
                    <label for="vanue">Початок заняття:</label>
                    <input type="time" asp-for="Time">
                    <label for="vanue">Кінцець заняття:</label>
                    <input type="time" asp-for="EndTime">
                    <input type="submit" value="Створити" class="button" />
                    <input type="hidden" asp-for="StudyGroupId" />
                </form>
              
            </div>
            <div class="schedule-container">
                <table class="table table-dark">
                    <thead class="table-dark th1">
                        <tr><th class="th">Місце</th><th>День</th><th>початок</th><th>кінець</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var shedules in Model.Schedules)
                        {
                            <tr>
                                <td>@shedules.Place.DestinationAddress</td>
                                <td>@shedules.DayOfWeek</td>
                                <td>@shedules.startTime</td>
                                <td>@shedules.endTime</td>
                            </tr>
                        }
                    </tbody>
               
                </table>
            </div>
      </section>