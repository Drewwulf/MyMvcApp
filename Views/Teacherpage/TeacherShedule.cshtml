
@model MyMvcApp.Models.ViewModels.SheduleViewModel

<section class="section">
  
    <div class="mainDiv" id="MainDiv">
        <div class="nameDiv">
            <p>Ім'я</p>
        </div>
        <div class="lessonDiv">
            <p>Hаступні заняття:</p>



            <table class="table table- table4">
                <thead class="table-dark th1">
                    <tr class="headTr"><th class="th"><i class="bi bi-geo-alt-fill"></i>Місце</th><th class="th"><i class="bi bi-calendar"></i>День</th><th class="th"><i class="bi bi-alarm-fill"></i>Початок</th><th class="th"><i class="bi bi-alarm-fill"></i>Кінець</th><th class="th">Група</th></tr>
                </thead>
                <tbody>
                    @foreach (var shedules in Model.Schedules)
                    {
                        <tr class="tr">
                            <td>@shedules.Place.DestinationAddress</td>
                            <td>@shedules.DayOfWeek</td>
                            <td>@shedules.startTime.TimeOfDay</td>
                            <td>@shedules.endTime.TimeOfDay</td>
                            <td>@shedules.StudyGroup.GroupName</td>
                        </tr>
                    }
                </tbody>
               
            </table>



        </div>
    </div>
</section>