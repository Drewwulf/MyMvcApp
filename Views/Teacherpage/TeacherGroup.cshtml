
@model List<StudyGroup>
<section class="section">
    <div class="photoDiv">
        <img src="/image/account_circle_500dp_BLACK_FILL0_wght400_GRAD0_opsz48.png">
    </div>
    <div class="mainDiv">
        <div class="nameDiv">
            <p>Ім'я</p>
        </div>
        <div class="lessonDiv">
            <p>Hаступні заняття:</p>


            
       
                 <div class="table2">
                    <table class="table">
                       <thead class="table-dark th1">
                           <tr><th class="th">Номер</th><th>Назва</th><th>Опис</th><th>Дії</th></tr>
                       </thead>
                       <tbody>
                           
                           



                        @foreach (var group in Model)
                        {
                           <tr><td>@group.StudyGroupId</td>
                           <td>@group.GroupName</td>
                           <td>@group.GroupDescription</td>
                                <td><a asp-controller="Teacherpage" asp-action="Details" asp-route-id="@group.StudyGroupId" type="button" class="btn btn-dark">Деталі</a></td>
                           </tr>



                        }
                        </tbody>
                    </table>
                </div>
                
            

        </div>
    </div>
</section>
