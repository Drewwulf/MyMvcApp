@using Microsoft.AspNetCore.Mvc.ModelBinding
@model MyMvcApp.Models.ViewModels.StudyGroupViewModel
<section class="section">
      <div class="mainDiv">
                <div class="divselect">
                    <h2>@Model.Group.GroupName </h2>
                    <p>@Model.Group.GroupDescription</p>
                    @foreach(var studentstogroup in Model.Group.StudentToGroups)
                        {
                           <tr><td>@studentstogroup.student.Username</td></tr>
                        }
                </div>
            </div>
    </section>
@section Scripts
        {
    <partial name="_ValidationScriptsPartial" />
}