@model MyMvcApp.Models.TaskViewModel
<section class="section">
    <div class="mainDiv">
        <form class="p-3" asp-controller="Task" asp-action="Create" asp-route-id="@Model.TestId" method="post" c>
            <h3 style="color : whitesmoke; margin-block: 5px;">Hазва : @Model.Test.FirstOrDefault().TestName</h3>
            <p style = "margin-block: 5px;">Деталі : @Model.Test.FirstOrDefault().TestDescription</p>
            <p style="margin-block: 5px">Складність : @Model.Test.FirstOrDefault().TestDifficualty</p>
            <input type="text" asp-for="Name" asclass="form-control mb-3" placeholder="Назва" required  />
                <input type="text" asp-for="Description" class="form-control mb-4" placeholder="Опис"  required>
                <select asp-for="TaskType" class="form-select" aria-label="Default select example">
                <option value="Radio">Radio (1 Відповідь)</option>
                <option value="CheckBox">CheckBox (2 відповіді і більше)</option>
               </select>

   
                    <div class="d-flex align-items-center mb-2">
                    </div>


   
                    <input type="hidden" asp-for="TestId">
                        <button type="submit" class="btn btn-dark w-100">Створити</button>
                       
               
                </form> <a asp-controller="Test" asp-action="Create" style="margin-top : 15px" class="btn btn-dark">Повернутися назад</a>
                </div>
            </section>
            <section>
                <div class="table2">
                    <table class="table">
                        <thead class="table-dark">
                            <tr><th>Номер</th><th>Назва</th><th>Опис</th><th>Дії</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var task in Model.Question)
                            {
                                <tr>
                                    <td>1</td>
                                    <td>@task.QuestionName</td>
                                    <td>@task.QuestionDescription</td>
                                    <td>
                                        <a type="button" asp-controller="Task" asp-action="Edit" asp-route-id="@task.QuestionId" class="btn btn-secondary">Редагувати</a>
                                        <a asp-controller="Answer" asp-action="Details" asp-route-id="@task.QuestionId" type="button" class="btn btn-dark">Деталі</a>
                                        <a type="button" asp-controller="Task" asp-action="Delete" asp-route-id="@task.QuestionId" class="btn btn-danger">Видалити</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>