@{
    ViewData["Title"] = "TableUsers";
}
@model List<UsersViewModel>
<section class="section">
    <div class="table2">
        <table>
            <thead>
                <tr>
                    <td>№ користувача</td>
                    <td>Роль</td>
                    <td>Email (Gmail)</td>
                </tr>
            </thead>
            <tbody>
@foreach (var user in Model)
{
    <tr>
        <td>@user.Id</td>
        <td>@user.Role</td>
        <td>@user.Email</td>
    </tr>
}
</tbody>
        </table>
    </div>
</section>
@section Scripts
    {
        <partial name="_ValidationScriptsPartial" />
    }