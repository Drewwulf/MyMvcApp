@{
    ViewData["Title"] = "TableUsers";
}
@model List<UsersViewModel>
<section class="section">
    <div class="table2">
        <table>
            <thead>
                <tr>
                    <td>№ користувача</td>
                    <td>Роль</td>
                    <td>Email (Gmail)</td>
                </tr>
            </thead>
            <tbody>
@foreach (var user in Model)
{
    <tr>
        <td>@user.Id</td>
        <td>@user.Role</td>
        <td>@user.Email</td>
        <td><a asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@user.Id">Видалити</a></td><td><a asp-controller="Admin" asp-action="EditUsers" asp-route-id="@user.Id">Редагувати</a></td>
    </tr>
} 
</tbody>
        </table>
    </div>
</section>
@section Scripts
    {
        <partial name="_ValidationScriptsPartial" />
    }