@{
    ViewData["Title"] = "TableUsers";
}
@model List<UsersViewModel>
<section class="section">
    <div class="table2">
        <table class="table ">
            <thead class="table-dark th1">
                <tr>
                    <th>Імя,Призвіще</th>
                    <th>Роль</th>
                    <th>Email (Gmail)</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
@foreach (var user in Model)
{
    <tr>
        <td>@user.UserName.Replace(".", " ")</td>
        <td>@user.Role</td>
        <td>@user.Email</td>
                        <td><a asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-danger">Видалити</a><a asp-controller="Admin" asp-action="EditUsers" asp-route-id="@user.Id" class="btn btn-secondary">Редагувати</a></td>
    </tr>
} 
</tbody>
        </table>
    </div>
</section>
@section Scripts
    {
        <partial name="_ValidationScriptsPartial" />
    }