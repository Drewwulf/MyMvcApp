@{
    ViewData["Title"] = "Створити користувача";
}

<h2 class="finishText" style=""> Створення користувача </h2>

@if (ViewBag.Success != null)
{
    <p style="color:green">@ViewBag.Success</p>
}

<form method="post" class="mainDiv">
    <div>
        <br />
        <input name="email" required placeholder="Email"/>
    </div>

    <div>
       <br />
        <input name="password" type="password" required placeholder="Пароль"/>
    </div>
    <div style="display: flex; gap: 10px; justify-content: center;">
        <div>
            <br />
            <input name="FirstName" type="text" required placeholder="Ім'я" />
        </div>
        <div>
            <br />
            <input name="LastName" type="text" required placeholder="Прізвище" />
        </div>
    </div>

   <br />
        <select name="role" class="form-select">
            <option value="Admin">Admin</option>
            <option value="Teacher">Teacher</option>
            <option value="Student">Student</option>
        </select>

    <br />
    <input class="submit" type="submit" value="Створити">
</form>

@if (!ViewData.ModelState.IsValid)
{
    <ul style="color:red">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <li>@error.ErrorMessage</li>
        }
    </ul>
}
