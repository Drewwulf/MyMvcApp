<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyMvcApp</title>
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/GroupDetails.css" />
    <link rel="stylesheet" href="/css/Create.css" />
    <link rel="stylesheet" href="/css/color.css" />
        <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/details.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyMvcApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-controller="Teacherpage" asp-action="TeacherCabinet">Кабінет вчителя</a>
                    <button
                        class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNavAltMarkup"
                        aria-controls="navbarNavAltMarkup"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
                        <div class="navbar-nav">
                        
                            <a class="nav-link" asp-controller="Teacherpage" asp-action="TeacherGroup"> Групи</a>
                            <a class="nav-link" asp-controller="HomeWork" asp-action="Info">Д/З учнів</a>
                            <a class="nav-link" asp-controller="Teacherpage" asp-action="TeacherShedule">Розклад </a>
                            <a class="nav-link " asp-controller="HomeWork" asp-action="Create">Створення Д/З</a>
                        <a class="nav-link" asp-controller="Teacherpage" asp-action="LiderBoard">Таблиця лідерів</a>
                            <a class="nav-link " asp-controller="Account" asp-action="Logout">Вийти</a>
                            
                            
                        </div>
                    </div>
                </div>
            </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <footer >
            <div class="divfooter">
                <div class="divfootsect">
                     <h4 class="h4footer">Загальне</h4>
                    <ul class="ulfooter">

                        <li><a>Корисні посилання</a></li>
                        <li><a>Навігація по веб сайту</a></li>
                        <li><a>Контакти</a></li>

                    </ul>
                </div>
                <div class="divfootsect">
                    <h4 class="h4footer">Завдання</h4>
                <ul class="ulfooter">
                        <li><a asp-controller="Teacherpage" asp-action="Homework">Домашня</a></li>
                        <li><a asp-controller="Teacherpage" asp-action="TeacherShedule">Розклад</a></li>
                        <li><a asp-controller="Teacherpage" asp-action="TeacherGroup">Групи</a></li>
                        <li><a asp-controller="Teacherpage" asp-action="LiderBoard">Лідери</a></li>
                    </ul>



                </div>
                <div class="divfootsect">
                    <h4 style="margin: 0 auto" class="h4footer">Контакти</h4>
                <ul class="ulfooter">
                        <li><a>Номер телефона:82393029</a></li>
                        <li><a>Gmail:cobtahacademy@gmail.com</a></li>
                        <li><a>Адрес:Вул.Вакарова 13</a></li>

                    </ul>



                </div>  
            </div>
        </footer>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
