@using System.Text.RegularExpressions
@model MyMvcApp.Models.ViewModels.SheduleViewModel

      <section class="mainSection">
          <div class="firstDiv">
        <p><i class="bi bi-calendar calendarIcon"></i></p>
              <h2 class="mainH">Мій розклад</h2>
              <hr class="hr">
              <p class="pSchedule">Тут ви можете подивитися свій розклад</p>
          </div>
          <div class="thirdDiv">
        <div class="schedule-container secondDiv">
            <table class="table table- table4">
                <thead class="table-dark th1">
                <tr class="headTr"><th class="th"><i class="bi bi-geo-alt-fill"></i>Місце</th><th class="th"><i class="bi bi-calendar"></i>День</th><th class="th"><i class="bi bi-alarm-fill"></i>Початок</th><th class="th"><i class="bi bi-alarm-fill"></i>Кінець</th></tr>
                </thead>
                <tbody>
                    @foreach (var shedules in Model.Schedules)
                    {
                        <tr class="tr">
                            <td>@shedules.Place.DestinationAddress</td>
                            <td>@shedules.DayOfWeek</td>
                            <td>@shedules.startTime.TimeOfDay</td>
                            <td>@shedules.endTime.TimeOfDay</td>
                        </tr>
                    }
                </tbody>
               
            </table>
        </div>
    </div>
            </section>
