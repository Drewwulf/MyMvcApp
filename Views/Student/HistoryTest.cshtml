@model List<ResultTest>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

@foreach (var result in Model)
{

   
        string color = "";
    if (result.Score < 60)
    {
        color = "badscore";
    }
    else if (result.Score>=60 && result.Score <= 80)
    {
        color = "midscore";
    } 
    else if (result.Score > 80)
    {
        color = "goodscore";
    }

    <div class="test-result-card">

        <div class="test-result-header @color ">

            <div class="test-result-icon @color">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>

            <div class="test-result-info">
                <h2>@result.Test.TestName</h2>
                <p>@result.Test.TestDescription</p>
            </div>

        </div>

        <div class="test-result-details">

            <div class="test-result-box testbox2 @color"    >
                <span>Ваш результат</span>
                <h3>@result.Score %</h3>
            </div>

            <div class="test-result-box">
                <span>Час проходження тесту</span>
                <h3>@result.DateTime.ToString("dd.MM.yyyy HH:mm:ss")</h3>
            </div>

        </div>

    </div>
}