@model MyMvcApp.Models.ViewModels.ScoreViewModel

<div class="mainDiv">
    <h1>Тест завершено!</h1>
    <hr />
    
    <h3>Твій результат:</h3>
    <h2 style="color: #28a745;">@Model.Score / @Model.TotalQuestions</h2>
    
    <p>Успішність: @Model.Percentage%</p>
    
    <a class="btn btn-dark" asp-controller="Student" asp-action="Directions">Повернутись</a>
</div>