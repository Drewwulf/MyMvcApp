@model MyMvcApp.Models.ViewModels.StudentPageViewModel
<section class="section">
    @foreach (var g in Model.allGroups)
    {
     
            <div class="mainDiv">
                <h2>@g.studyGroup.GroupName</h2>
                <div class="mainDiv3">
                    <div class="geoDiv">
                        <i class="bi bi-mortarboard"></i>
                        <p>Вчитель : @g.studyGroup.Teachers</p>
                    </div>
                    <div class="geoDiv">
                        <i class="bi bi-geo-alt"></i>
                        <p>Місце проведення :</p>
                        <p>@g.studyGroup.Place.DestinationName </p>
                    <p> (@g.studyGroup.Place.DestinationAddress)</p>
                    </div>
                </div>
                <p>Субота,10:00-13:20</p>
            </div>
  
    }
    
</section>
        

<div class="schedule-container secondDiv">
    <table class="table table- table4">
        <thead class="table-dark th1">
            <tr class="headTr"><th class="th"><i class="bi bi-calendar"></i>День</th><th class="th"><i class="bi bi-alarm-fill"></i>Початок</th><th class="th"><i class="bi bi-alarm-fill"></i>Кінець</th></tr>
        </thead>
        <tbody>
            @foreach (var StudyGroup in Model.allGroups.First().studyGroup.Schedule)
            {
                <tr class="tr">
                    
                    <td>@StudyGroup.DayOfWeek</td>
                    <td>@StudyGroup.startTime.TimeOfDay</td>
                    <td>@StudyGroup.endTime.TimeOfDay</td>
                </tr>
            }
        </tbody>
               
    </table>
</div>