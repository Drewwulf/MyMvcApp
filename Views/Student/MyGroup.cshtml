@model MyMvcApp.Models.ViewModels.StudentPageViewModel
<section class="section">
    @foreach (var g in Model.allGroups)
    {
     
            <div class="mainDiv">
                <h2>@g.studyGroup.GroupName</h2>
                <div class="mainDiv3">
                    <div class="geoDiv">
                        <i class="bi bi-mortarboard"></i>
                        <p>Вчитель : @g.studyGroup.Teachers</p>
                    </div>
                    <div class="geoDiv">
                        <i class="bi bi-geo-alt"></i>
                        <p>Місце проведення :</p>
                        <p>@g.studyGroup.Place.DestinationName </p>
                    <p> (@g.studyGroup.Place.DestinationAddress)</p>
                    </div>
                </div>
                <p>Субота,10:00-13:20</p>
            </div>
  
    }
    
</section>
