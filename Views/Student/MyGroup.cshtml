@model MyMvcApp.Models.ViewModels.StudentPageViewModel
<section class="section">
    @foreach (var group in Model.groups) 
    {
        <div class="mainDiv">
            <h2>@group.GroupName</h2>
            <div class="mainDiv3">
                <div class="geoDiv">
                    <i class="bi bi-mortarboard"></i>
                    <p>Вчитель : @group.Teachers.UserName</p>
                </div>
                <div class="geoDiv">
                    <i class="bi bi-geo-alt"></i>
                    <p>Місце проведення :</p>
                    <p>@group.Place.DestinationName </p>
                    <p> (@group.Place.DestinationAddress)</p>
                </div>
            </div>
            <p>Субота,10:00-13:20</p>
        </div>
    }
</section>
