@model MyMvcApp.Models.ViewModels.StudentDirectionViewModel

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<div class="studentDashboard">

    <div class="studentInfoCard">

        <div class="studentInfo">
            <div class="studentIcon levelIcon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <div>
                <span class="studentLabel">Рівень</span>
                <h2>@Model.StudentLevel</h2>
            </div>
        </div>

        <div class="leaderboardButton">
            <a asp-controller="Student" asp-action="LiderBoard">
                <i class="fa-solid fa-trophy"></i>
                Таблиця лідерів
            </a>
        </div>

        <div class="studentInfo rightInfo">
            <div class="studentIcon pointsIcon">
                <i class="fa-solid fa-star"></i>
            </div>

            <div>
                <span class="studentLabel">Досвід</span>
                <h2>@Model.StudentPoints XP</h2>
            </div>
        </div>

    </div>

</div>

<section class="directions">
    <section class="section">
        @foreach (var direction in Model.directions)
        {
            <div class="mainDiv">
                <h2>@direction.DirectionName</h2>

                <div class="mainDiv3">
                    <p>@direction.DirectionDescription</p>

                    <div class="buttonDiv">
                        <a asp-controller="Student"
                               asp-action="Tests"
                               asp-route-id="@direction.DirectionId"
                               class="btn btn-dark">
                            Подивитися тести
                        </a>
                    </div>
                </div>
            </div>
        }
    </section>
</section>