@model List<MyMvcApp.Models.Question>

<div class="testHeaderCard">
    <h2 class="testTitle">@Model.First().Test.TestName</h2>
    <p class="testDescription">@Model.First().Test.TestDescription</p>
</div>

<form method="post" asp-action="CheckTest" class="testForm">

    @for (int i = 0; i < Model.Count; i++)
    {
        <input type="hidden" name="[@i].QuestionId" value="@Model[i].QuestionId" />

        <div class="questionCard">

            <h2 class="questionTitle">
                Питання @(i + 1)
            </h2>

            <h4 class="questionName">
                @Model[i].QuestionName
            </h4>

            <p class="questionDescription">
                @Model[i].QuestionDescription
            </p>

            <div class="answersContainer">

                @foreach (var ans in Model[i].Answers)
                {
                    <label class="answerItem">

                        @switch (ans.Question.QuestionType)
                        {
                            case "Radio":
                                <input class="answerRadio"
                                       type="radio"
                                       id="ans_@ans.Id"
                                       name="[@i].SelectedAnswerId[0]"
                                       value="@ans.Id"
                                       required />
                                break;

                            case "CheckBox":
                                <input class="answerCheckbox"
                                       type="checkbox"
                                       id="ans_@ans.Id"
                                       name="[@i].SelectedAnswerId"
                                       value="@ans.Id" />
                                break;
                        }

                        <span>@ans.answerName</span>

                    </label>
                }

            </div>

        </div>
    }

    <div class="submitContainer">
        <button class="submitTestButton">
            ✈ Здати тест
        </button>
    </div>

</form>