@using Microsoft.AspNetCore.Mvc.ModelBinding
@model MyMvcApp.Models.TestViewModel
    <section class="section">

    <div class="mainDiv">

        <div class="divselect">
            <h2>@Model.Name</h2>
            <p>@Model.Description</p>
        </div>

        <div class="buttons">
            <a href="/Test/Edit/1" class="btn-shedule">
                Редагувати
            </a>

            <a asp-controller="Task"
               asp-action="Tasks"
               asp-route-id="@Model.TestId"
               class="btn-shedule">
                Додати завдання
            </a>
        </div>

    </div>

</section>
            @section Scripts
        {
            <partial name="_ValidationScriptsPartial" />
                    }