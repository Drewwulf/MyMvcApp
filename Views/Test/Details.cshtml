@using Microsoft.AspNetCore.Mvc.ModelBinding
@model MyMvcApp.Models.TestViewModel
<section class="section">
    <div class="mainDiv">
        <div class="maindiv2">
            <h2 class="h2white">Назва тесту: @Model.Name </h2>
            <p>Опис тесту: @Model.Description</p>
        </div>
        <a asp-controller="Test" asp-action="Create" class="btn btn-dark">Повернутися назад</a>
        <a asp-controller="Task" asp-action="Tasks" asp-route-id="@Model.TestId" class="btn btn-dark">Додати завдання</a>
    </div>
</section>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}