@model MyMvcApp.Models.TestViewModel
        <section class="section">
            <div class="mainDiv">
                <form asp-action="Create" method="post">
                    <input asp-for="Name" type="text" placeholder="Назва">
                    <input asp-for="Description"type="text" placeholder="Опис">
               

                    <select asp-for="difficualtyEnum" class="form-select" aria-label="Default select example">
                        @foreach (var difficualtyEnum in Model.TestDifficualty)
                        {
                            
                            <option value=@difficualtyEnum>@difficualtyEnum</option>

                        }
                    </select>

                    <br />
                    <select asp-for="DirectionId" class="form-select" aria-label="Default select example">
  @foreach(var direction in Model.directions)
                        {
                            
<option value=@direction.DirectionId>@direction.DirectionName</option>

                        }
                    </select>
                    <br />
                    <input type="submit" value="Створити" class="submit">
                </form>
            </div>
        </section>
            <section>
                <div class="table2">
                    <table class="table">
                       <thead class="table-dark">
                           <tr><th>Номер</th><th>Назва</th><th>Опис</th><th>Складність</th><th>Дії</th></tr>
                       </thead>
                       <tbody>
                            @foreach(var test in Model.test)
                                                if (test.isdeleted == false){
                        {
                           <tr><td>@test.TestId</td><td>@test.TestName</td><td>@test.TestDescription</td><td>@test.TestDifficualty</td>
                           <td>

                               <a type="button" class="btn btn-secondary" asp-controller="Test" asp-action="Edit" asp-route-id="@test.TestId"
                            >Редагувати</a>

                            <a type="button" asp-controller="Task" asp-action="Tasks" asp-route-id="@test.TestId"
                             class="btn btn-dark">Деталі</a>

                            <a type="button"  asp-controller="Test" asp-action="Delete" asp-route-id="@test.TestId"
                               class="btn btn-danger">Видалити</a>

                         </td></tr>
                            
                         }

                        }
                        </tbody>
                    </table>
                </div>
            </section>

            @section Scripts
        {
            <partial name="_ValidationScriptsPartial" />
        }