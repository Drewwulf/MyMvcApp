@using Microsoft.AspNetCore.Mvc.ModelBinding
@model MyMvcApp.Models.StudyGroupViewModel

<section class="section2 container my-4 groups-wrapper">

    <!-- Блок групи -->
    <div class="mainDiv card p-4 mb-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="card-title">@Model.Group.GroupName</h2>
            <a href="/Views/Group/Edit.html" class="btn btn-primary btn-sm">Редагувати</a>
        </div>

        <div class="divselect mb-3">
            <p class="mb-1"><strong>Опис групи:</strong> @Model.Group.GroupDescription</p>
            <p class="mb-1"><strong>Напрямок:</strong> @Model.Group.Direction.DirectionName</p>
            <p class="mb-0"><strong>Вчитель:</strong> @Model.Group.Teachers.UserName</p>
        </div>

        <a asp-controller="Schedule" asp-action="Create"class="btn btn-success mt-2">Додати розклад групи</a>
    </div>

    <!-- Блок студентів -->
    <div class="right-section-students card p-3 shadow-sm mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="total-count-kpi">
                <div class="kpi-value-total fs-3" id="totalStudentsCount">@Model.studentsToGroup.Count</div>
                <div class="kpi-label-total small">Загальна кількість учнів</div>
            </div>
            <form asp-action="AddStudentToGroup">
            <div class="add-button-container">
                <h5>Список Учнів</h5>
               <select asp-for="StId">
                        @foreach (var student in Model.students)
                        {
                            <option value=@student.Id>@student.Username</option>

                        }
               </select>
               <input type="hidden" asp-for="GrId" />
                <button type="submit" class="btn btn-outline-primary btn-sm">+ Додати Нового</button>
            </div>
            </form>
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }
        </div>
     
        <div class="table-responsive">
            <table class="table table-striped table-hover students-table mb-0 table-dark">
                <thead class="table-dark">
                    <tr>
                        <th>Ім'я та Прізвище</th>
                        
                    </tr>
                </thead>
                <tbody id="studentsListBody" class="table-dark">
                    @foreach (var studentToGroup in Model.studentsToGroup)
                    {
                       <tr class="table-dark">
                           <td>@studentToGroup.student.Username</td>
                            
                       </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Блок розкладу -->
    <div class="schedule-container card p-3 shadow-sm">
        <h5>Розклад Занять Групи [G03]</h5>

        <div class="table-responsive">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>День Тижня</th>
                        <th>Початок Дня</th>
                        <th>Кінець Дня</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>Понеділок</td><td>-</td><td>-</td></tr>
                    <tr><td>Вівторок</td><td>-</td><td>-</td></tr>
                    <tr><td>Середа</td><td>-</td><td>-</td></tr>
                    <tr><td>Четвер</td><td>-</td><td>-</td></tr>
                    <tr><td>П'ятниця</td><td>-</td><td>-</td></tr>
                </tbody>
            </table>
        </div>
    </div>

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}