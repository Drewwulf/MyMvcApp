@model MyMvcApp.Models.ViewModels.AnswerViewModel
<section class="section">
    <div class="mainDiv">
        <form class="p-3" asp-controller="Answer" asp-action="Create" method="post">
            <h1 class="Questionname">@Model.task.QuestionName</h1>
            <hr />
            <p class="QuestionDescription">@Model.task.QuestionDescription</p>
            <div class="d-flex align-items-center mb-2">
                <input type="text" asp-for="AnswerName" class="form-control me-3" placeholder="Перша відповідь">
                    <input asp-for="IsCorrect" style="width:50px; height:40px; margin: 0px 10px 30px 10px" type="checkbox" class="form-check-input">
                    </div>

                    <input type="hidden" asp-for="TaskId">
                        <button type="submit" class="btn btn-dark w-100">Створити</button>

                    </form>
                </div>
                <section>
                    <div class="table2">
                        <table class="table">
                            <thead class="table-dark th1">
                                <tr><th class="th">Номер</th><th>Назва</th><th>Cтатус</th><th>Дії</th></tr>
                            </thead>
                            <tbody>
                           
                           



                                @foreach (var answer in Model.answers)
                                {
                        
                               
                                        <tr>
                                            <td>@answer.QuestionId</td>
                                            <td>@answer.answerName</td>
                                        <td>@(answer.IsCorrect ? "Так" : "Ні")</td>
                                            <td>
                                                <a type="button" asp-controller="Answer" asp-action="Edit" asp-route-id="@answer.Id" class="btn btn-secondary">Редагувати</a>
                                                <a type="button" asp-controller="Answer" asp-action="Delete" asp-route-id="@answer.Id" class="btn btn-danger">Видалити</a>
                                            </td>
                                        </tr>
                                    
                    
                                }
                            </table>
                        </div>
                    </section>

                </section>



