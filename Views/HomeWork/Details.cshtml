@using Microsoft.AspNetCore.Mvc.ModelBinding
@model MyMvcApp.Models.HomeworkViewModel
<section class="section">
    <div class="mainDiv">
        <div class="maindiv2">
            <h1 class="hmwname">Назва:@Model.HomeworkName</h1>
