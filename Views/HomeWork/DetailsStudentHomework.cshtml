@model MyMvcApp.Models.HomeworkViewModel
<p>@Model.HomeworkName</p>
<p>@Model.HomeworkDescription</p>
@if (@Model.HomeworkInfos.FirstOrDefault() != null)
{
    <p>@Model.HomeworkInfos.FirstOrDefault().Text</p>
}
<a asp-controller = "HomeWork" asp-action="Download" asp-route-id="@Model.HomeworkInfos.FirstOrDefault().HomeworkInfoId">Скачати</a>
